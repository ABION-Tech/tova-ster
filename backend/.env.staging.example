# Staging: a private copy for testing. Never put live keys here.
NODE_ENV=production
DATABASE_URL=            # the staging Postgres (Railway staging environment)
SESSION_SECRET=          # long random string, different from production
APP_URL=                 # staging shop address, e.g. https://staging.tova-ster.com
CORS_ORIGIN=             # same as APP_URL
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=       # sk_test_… (TEST key only)
STRIPE_WEBHOOK_SECRET=   # whsec_… from the staging test webhook
RESEND_API_KEY=          # leave empty: emails are logged, not sent
EMAIL_FROM=
CLOUDINARY_CLOUD_NAME=   # can share production, or use a separate folder
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
INSTAGRAM_APP_ID=        # optional on staging
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
BACKUP_DIR=/data/backups
KEEP_DAYS=7
