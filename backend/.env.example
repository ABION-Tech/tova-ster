NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/wellness_ecom
CORS_ORIGIN=http://localhost:3000
# Frontend base URL — used to build the links inside verification/reset emails.
APP_URL=http://localhost:3000

# Payment (PaymentService). UK launch provider: Stripe (hosted Checkout).
# Webhook endpoint to register in Stripe: POST {API_URL}/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Inactive alternative adapters
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# UK delivery (GBP, VAT-inclusive) — PLACEHOLDERS until the client confirms carrier rates
DELIVERY_FEE_MAINLAND=3.99
DELIVERY_FEE_HIGHLANDS=7.99
DELIVERY_FEE_NI=5.99
FREE_DELIVERY_THRESHOLD=40

# Storage (StorageService — wired in Stage 4)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (EmailService — wired in Stage 10; ConsoleEmailAdapter logs instead until then)
RESEND_API_KEY=
EMAIL_FROM=

# Auth (Stage 3) — sessions are opaque server-side tokens, not JWTs, so
# there's no JWT_SECRET. SESSION_SECRET is the HMAC key used to hash
# session/verification/reset tokens before they're stored — required in
# production (the app refuses to start without it there), and long/random.
SESSION_SECRET=
